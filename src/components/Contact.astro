---
import { site } from '../data/site';
import ContactForm from './ContactForm.astro';

interface Props {
  /** slug del servicio preseleccionado en el formulario. */
  service?: string;
}
const { service } = Astro.props;

const links = [
  { label: 'Email', value: site.email, href: `mailto:${site.email}`, external: false },
  { label: 'LinkedIn', value: 'Ashlyn Abraham Cedeño Holguín', href: site.linkedin, external: true },
  { label: 'GitHub', value: 'github.com/abrahamcedeno', href: site.github, external: true },
];
---

<section id="contacto" class="bg-surface-2 py-22">
  <div class="wrap">
    <div class="grid gap-10 md:grid-cols-[1.5fr_1fr] md:gap-12">
      <div>
        <p class="mb-3.5 text-[12.5px] font-semibold tracking-[0.14em] text-accent uppercase" data-reveal>
          Contacto
        </p>
        <h2 class="text-[clamp(28px,6vw,42px)] font-bold text-ink" data-reveal>
          ¿Tienes un proyecto en mente?
        </h2>
        <p class="mt-4 mb-8 max-w-[560px] text-lg text-muted" data-reveal>
          Una web, un dispositivo o un panel de control: cuéntame qué necesitas y
          te respondo con cómo lo haría, cuánto costaría y en cuánto tiempo.
        </p>
        <div class="rounded-card bg-surface p-6 shadow-card sm:p-8" data-reveal>
          <ContactForm service={service} />
        </div>
      </div>

      <aside class="grid content-start gap-3 md:pt-[148px]">
        <p class="font-mono text-[12px] font-medium tracking-wide text-accent uppercase">¿Prefieres otro canal?</p>
        {links.map((l, i) => (
          <a
            href={l.href}
            target={l.external ? '_blank' : undefined}
            rel={l.external ? 'noopener' : undefined}
            class="group flex items-center justify-between gap-4 rounded-2xl bg-surface p-5 shadow-card transition hover:-translate-y-0.5 hover:shadow-card-lg"
            data-reveal
            style={`--reveal-delay:${i * 70}ms`}
          >
            <span class="min-w-0">
              <span class="block font-mono text-[12px] font-medium tracking-wide text-accent uppercase">{l.label}</span>
              <span class="block truncate text-[15px] font-semibold text-ink">{l.value}</span>
            </span>
            <span class="text-accent transition-transform group-hover:translate-x-1" aria-hidden="true">{l.external ? '↗' : '→'}</span>
          </a>
        ))}
        <p class="mt-2 text-[14px] text-muted">
          ¿Quieres ver precios antes? <a href="/servicios" class="font-semibold text-accent hover:underline">Consulta los servicios y sus niveles</a>.
        </p>
      </aside>
    </div>
  </div>
</section>
