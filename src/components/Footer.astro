---
import { site } from '../data/site';
import { services } from '../data/services';
const year = new Date().getFullYear();
---

<footer class="border-t border-sep bg-surface-2 py-9 text-[13px] text-muted">
  <div class="wrap flex flex-wrap items-center justify-between gap-3">
    <div>
      © {year} {site.name} · {site.role}<br />
      <span class="opacity-80">{site.legalName}</span>
    </div>
    <div class="flex flex-wrap items-center gap-4">
      {services.map((sv) => (
        <a href={`/servicios/${sv.slug}`} class="hover:text-accent">{sv.name}</a>
      ))}
      <a href={site.linkedin} target="_blank" rel="noopener" class="hover:text-accent">LinkedIn</a>
      <a href={site.github} target="_blank" rel="noopener" class="hover:text-accent">GitHub</a>
      <a href={`mailto:${site.email}`} class="hover:text-accent">Email</a>
      <a href={site.moovia} target="_blank" rel="noopener" class="hover:text-accent">MOOVIA</a>
      <a href="/blog" class="hover:text-accent">Blog</a>
      <a href="/privacidad" class="hover:text-accent">Privacidad</a>
      <span>{site.location}</span>
    </div>
  </div>
</footer>
