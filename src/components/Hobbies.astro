---
// Aficiones (secundaria). Tono humano y cálido: el contrapunto a lo técnico.
const hobbies = [
  {
    icon: '🏋️',
    title: 'Halterofilia',
    body: 'Levantar hierro me enseña lo mismo que un buen proyecto: técnica, progresión y paciencia. No hay atajos, solo constancia.',
  },
  {
    icon: '🏃',
    title: 'Running',
    body: 'Corro para pensar. Muchas de mis mejores ideas técnicas aparecen a mitad de una carrera, cuando la cabeza se ordena sola.',
  },
  {
    icon: '🐾',
    title: 'Pasear a mis perros',
    body: 'Mi desconexión total: mis perros, la calle y cero pantallas. Vuelvo con la cabeza despejada y con ganas de resolver.',
  },
];
---

<section id="aficiones" class="bg-surface-2 py-22">
  <div class="wrap">
    <p class="mb-3.5 text-[12.5px] font-semibold tracking-[0.14em] text-accent uppercase" data-reveal>
      Fuera del código
    </p>
    <h2 class="text-[clamp(28px,5vw,38px)] font-bold text-ink" data-reveal>
      Cuando cierro el portátil
    </h2>
    <p class="mt-3.5 mb-10 max-w-[560px] text-[17px] text-muted" data-reveal>
      Porque detrás de la ingeniería hay una persona. Esto es lo que me mantiene
      con energía y los pies en la tierra.
    </p>

    <div class="grid gap-5 sm:grid-cols-3">
      {hobbies.map((h, i) => (
        <div
          class="group rounded-card bg-surface p-6 shadow-card transition duration-300 hover:-translate-y-1 hover:shadow-card-lg"
          data-reveal
          style={`--reveal-delay:${i * 110}ms`}
        >
          <div class="anim-floaty mb-4 grid h-12 w-12 place-items-center rounded-2xl bg-surface-2 text-2xl">
            {h.icon}
          </div>
          <h3 class="mb-2 text-lg font-bold text-ink">{h.title}</h3>
          <p class="text-sm leading-relaxed text-body">{h.body}</p>
        </div>
      ))}
    </div>
  </div>
</section>
