---
import ThemeToggle from './ThemeToggle.astro';

// Enlaces absolutos (/#...) para que funcionen también desde /privacidad.
const links = [
  { href: '/servicios', label: 'Servicios' },
  { href: '/#sobre', label: 'Sobre mí' },
  { href: '/#sabe', label: 'Qué sé hacer' },
  { href: '/#resultados', label: 'Resultados' },
  { href: '/#trayectoria', label: 'Trayectoria' },
  { href: '/#ahora', label: 'Formación' },
];
---

<nav
  class="sticky top-0 z-50 border-b border-sep/70 bg-page/70 backdrop-blur-xl backdrop-saturate-150"
>
  <div class="wrap flex h-[58px] items-center justify-between gap-4">
    <a href="/" class="font-display text-base font-bold text-ink">
      Abraham<span class="text-accent">.</span>Cedeño
    </a>

    <div class="hidden items-center gap-6 text-sm font-medium text-body lg:flex">
      {links.map((l) => (
        <a href={l.href} class="transition-colors hover:text-accent">{l.label}</a>
      ))}
    </div>

    <div class="flex items-center gap-2">
      <ThemeToggle />
      <a
        href="/#contacto"
        class="rounded-full bg-ink px-4 py-2 text-[13.5px] font-semibold text-page transition hover:opacity-90"
      >
        Contactar
      </a>
      <!-- Menú móvil -->
      <details class="group relative lg:hidden" data-mnav>
        <summary
          class="grid h-9 w-9 cursor-pointer list-none place-items-center rounded-full bg-surface-2 text-ink [&::-webkit-details-marker]:hidden"
          aria-label="Abrir menú"
        >
          <svg viewBox="0 0 20 20" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
            <path d="M3 6h14M3 10h14M3 14h14" class="group-open:hidden" />
            <path d="M5 5l10 10M15 5L5 15" class="hidden group-open:block" />
          </svg>
        </summary>
        <div class="absolute right-0 top-[calc(100%+10px)] w-56 rounded-2xl border border-sep bg-surface p-2 shadow-card-lg">
          {links.map((l) => (
            <a href={l.href} class="block rounded-xl px-3 py-2.5 text-[14px] text-body transition-colors hover:bg-surface-2 hover:text-accent">
              {l.label}
            </a>
          ))}
        </div>
      </details>
    </div>
  </div>
</nav>

<script>
  // Cierra el menú móvil al elegir un enlace.
  document.addEventListener('astro:page-load', () => {
    document.querySelectorAll('[data-mnav]').forEach((d) => {
      d.querySelectorAll('a').forEach((a) =>
        a.addEventListener('click', () => d.removeAttribute('open'))
      );
    });
  });
</script>
