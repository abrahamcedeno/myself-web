---
import ThemeToggle from './ThemeToggle.astro';

const links = [
  { href: '#sobre', label: 'Sobre mí' },
  { href: '#soluciones', label: 'Soluciones' },
  { href: '#servicios', label: 'Servicios' },
  { href: '#codigo', label: 'Código' },
  { href: '#ahora', label: 'Ahora' },
];
---

<nav
  class="sticky top-0 z-50 border-b border-sep/70 bg-page/70 backdrop-blur-xl backdrop-saturate-150"
>
  <div class="wrap flex h-[58px] items-center justify-between">
    <a href="#" class="font-display text-base font-bold text-ink">
      Abraham<span class="text-accent">.</span>Cedeño
    </a>

    <div class="hidden items-center gap-7 text-sm font-medium text-body md:flex">
      {links.map((l) => (
        <a href={l.href} class="transition-colors hover:text-accent">{l.label}</a>
      ))}
    </div>

    <div class="flex items-center gap-2">
      <ThemeToggle />
      <a
        href="#contacto"
        class="rounded-full bg-ink px-4 py-2 text-[13.5px] font-semibold text-white transition hover:opacity-90 dark:bg-white dark:text-black"
      >
        Hablemos
      </a>
    </div>
  </div>
</nav>
