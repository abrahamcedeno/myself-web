---
// Formación actual. Mantener honesto: lo que estoy estudiando AHORA.
const tracks = [
  {
    tag: 'EN CURSO',
    title: 'IoT y nuevos protocolos de comunicación',
    body: 'Cómo viaja el dato del dispositivo a la nube: MQTT, brokers en Docker, Linux y publicación y suscripción con calidad de servicio y reconexión.',
    tags: ['MQTT', 'Docker', 'Linux', 'Python'],
  },
  {
    tag: 'EN CURSO',
    title: 'Seguridad en la comunicación IoT',
    body: 'Proteger el dispositivo y el canal: autenticación, cifrado de las comunicaciones, gestión de secretos y endurecimiento del sistema.',
    tags: ['Autenticación', 'Cifrado', 'Hardening'],
  },
  {
    tag: 'EN CURSO',
    title: 'Diseño avanzado de PCB',
    body: 'Curso completo de diseño de PCB en KiCad: librerías propias, checklist de fabricación y una placa diseñada, fabricada y montada por mí. Siguiente paso: PCB para módulos de radio a 2,4 GHz.',
    tags: ['KiCad', 'Librerías', 'DFM', 'RF 2,4 GHz'],
  },
];
---

<section id="ahora" class="bg-[#1c1c1e] py-22 text-white">
  <div class="wrap">
    <p class="mb-3.5 text-[12.5px] font-semibold tracking-[0.14em] text-[#5ac8fa] uppercase" data-reveal>
      Formándome ahora
    </p>
    <h2 class="text-[clamp(28px,5vw,38px)] font-bold text-white" data-reveal>En qué estoy creciendo</h2>
    <p class="mt-3.5 mb-10 max-w-[600px] text-[17px] text-[#8e8e93]" data-reveal>
      Sigo formándome para que tu proyecto use tecnología actual y segura.
      Esto es lo que estudio en este momento.
    </p>

    <div class="grid gap-5 md:grid-cols-3">
      {tracks.map((t, i) => (
        <div
          class="flex flex-col rounded-2xl bg-[#2c2c2e] p-6 shadow-[0_10px_30px_rgba(0,0,0,0.25)]"
          data-reveal
          style={`--reveal-delay:${i * 100}ms`}
        >
          <p class="mb-3 inline-flex items-center gap-2 font-mono text-xs text-[#5ac8fa]">
            <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-[#30d158]"></span>{t.tag}
          </p>
          <h3 class="mb-2 font-display text-lg text-white">{t.title}</h3>
          <p class="flex-1 text-[14px] leading-relaxed text-[#a1a1a6]">{t.body}</p>
          <div class="mt-4 flex flex-wrap gap-1.5">
            {t.tags.map((x) => (
              <span class="rounded-md bg-white/[0.08] px-2.5 py-1 font-mono text-[11.5px] text-white/85">{x}</span>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
