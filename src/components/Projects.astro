---
import { getCollection } from 'astro:content';

const projects = (await getCollection('projects'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => a.data.order - b.data.order);

const covers: Record<number, string> = {
  1: 'from-[#e8f0ff] to-[#f5f5f7] dark:from-[#0a2a4a] dark:to-[#1c1c1e]',
  2: 'from-[#eafff2] to-[#f5f5f7] dark:from-[#10331f] dark:to-[#1c1c1e]',
  3: 'from-[#fff4e5] to-[#f5f5f7] dark:from-[#3a2a10] dark:to-[#1c1c1e]',
  4: 'from-[#f3e8ff] to-[#f5f5f7] dark:from-[#2a1a3a] dark:to-[#1c1c1e]',
};
---

<section id="proyectos" class="py-22">
  <div class="wrap">
    <p class="mb-3.5 text-[12.5px] font-semibold tracking-[0.14em] text-accent uppercase">
      Portfolio
    </p>
    <h2 class="text-[34px] font-bold text-ink">Proyectos seleccionados</h2>
    <p class="mt-3.5 mb-10 max-w-[560px] text-[17px] text-muted">
      Casos reales. Cada uno: reto → mi aportación → tecnología → resultado.
    </p>

    <div class="grid grid-cols-1 gap-5.5 md:grid-cols-2">
      {projects.map((p) => (
        <article
          class="flex flex-col overflow-hidden rounded-card bg-surface shadow-card transition duration-300 hover:-translate-y-1 hover:shadow-card-lg"
        >
          <div
            class:list={[
              'grid h-[150px] place-items-center bg-gradient-to-br font-mono text-xs text-muted',
              covers[p.data.cover],
            ]}
          >
            {p.data.title}
          </div>
          <div class="flex flex-1 flex-col p-6">
            <h3 class="mb-2 text-[19px] font-bold text-ink">{p.data.title}</h3>
            <p class="mb-4 flex-1 text-sm text-body">{p.data.summary}</p>
            <div class="mb-4 flex flex-wrap gap-1.5">
              {p.data.tags.map((tag) => (
                <span class="rounded-md bg-surface-2 px-2.5 py-1 font-mono text-[11.5px] text-muted">
                  {tag}
                </span>
              ))}
            </div>
            {(p.data.repo || p.data.demo) && (
              <div class="flex gap-4 text-[13.5px] font-semibold text-accent">
                {p.data.repo && (
                  <a href={p.data.repo} target="_blank" rel="noopener">GitHub ↗</a>
                )}
                {p.data.demo && (
                  <a href={p.data.demo} target="_blank" rel="noopener">Ver ↗</a>
                )}
              </div>
            )}
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
