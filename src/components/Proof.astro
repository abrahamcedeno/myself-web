---
import { site } from '../data/site';

// Prueba pública: en vez de logos de clientes, la garantía es el código abierto.
// Edita esta lista con tus repos/demos reales cuando subas el código.
const repos = [
  {
    name: 'edge-telemetry-lab',
    desc: 'Laboratorio de telemetría en el borde: envío de datos, contenedores y automatización.',
    href: 'https://github.com/abrahamcedeno/edge-telemetry-lab',
    tag: 'IoT · Edge',
  },
  {
    name: 'Este mismo sitio',
    desc: 'Web estática, rápida y accesible. Hecha con método y publicada en abierto.',
    href: site.github,
    tag: 'Web',
  },
];
---

<section id="codigo" class="py-22">
  <div class="wrap">
    <p class="mb-3.5 text-[12.5px] font-semibold tracking-[0.14em] text-accent uppercase" data-reveal>
      Garantía
    </p>
    <h2 class="max-w-[620px] text-[clamp(28px,5vw,38px)] font-bold text-ink" data-reveal>
      El código habla por mí
    </h2>
    <p class="mt-3.5 mb-10 max-w-[600px] text-[17px] text-muted" data-reveal>
      No hace falta que me creas: puedes verlo. Publico parte de mi trabajo en
      abierto, con historial de cambios y documentación. Esa es mi mejor carta
      de presentación.
    </p>

    <div class="grid gap-5 md:grid-cols-[1.1fr_1fr]">
      <!-- Panel GitHub -->
      <a
        href={site.github}
        target="_blank"
        rel="noopener"
        class="group relative flex flex-col justify-between overflow-hidden rounded-card bg-gradient-to-br from-[#1c1c1e] to-[#2c2c2e] p-7 text-white shadow-card transition duration-300 hover:-translate-y-1 hover:shadow-card-lg"
        data-reveal
      >
        <div>
          <div class="mb-5 inline-flex h-12 w-12 items-center justify-center rounded-2xl bg-white/10">
            <svg viewBox="0 0 24 24" class="h-7 w-7" fill="currentColor"><path d="M12 .5A11.5 11.5 0 0 0 .5 12a11.5 11.5 0 0 0 7.86 10.92c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.54-3.88-1.54-.53-1.34-1.3-1.7-1.3-1.7-1.06-.72.08-.71.08-.71 1.17.09 1.79 1.2 1.79 1.2 1.04 1.79 2.73 1.27 3.4.97.1-.76.41-1.27.74-1.56-2.55-.29-5.24-1.28-5.24-5.68 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.18 1.18a11 11 0 0 1 5.8 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.83 1.19 3.09 0 4.41-2.69 5.38-5.25 5.67.42.36.8 1.08.8 2.18v3.23c0 .31.21.67.8.56A11.5 11.5 0 0 0 23.5 12 11.5 11.5 0 0 0 12 .5Z"/></svg>
          </div>
          <h3 class="mb-2 font-display text-2xl font-bold">Mi GitHub, en abierto</h3>
          <p class="max-w-[42ch] text-[15px] text-white/80">
            Proyectos, historial y forma de trabajar. Transparencia total: lo que
            ves es lo que entrego.
          </p>
        </div>
        <span class="mt-8 inline-flex items-center gap-2 text-[14px] font-semibold text-[#5ac8fa]">
          Ver mi GitHub
          <span class="transition-transform duration-300 group-hover:translate-x-1">↗</span>
        </span>
      </a>

      <!-- Repos / demos -->
      <div class="grid gap-5">
        {repos.map((r, i) => (
          <a
            href={r.href}
            target="_blank"
            rel="noopener"
            class="group flex flex-col rounded-card bg-surface p-6 shadow-card transition duration-300 hover:-translate-y-1 hover:shadow-card-lg"
            data-reveal
            style={`--reveal-delay:${120 + i * 90}ms`}
          >
            <div class="mb-3 flex items-center justify-between">
              <span class="font-mono text-[13px] font-semibold text-ink">{r.name}</span>
              <span class="rounded-md bg-surface-2 px-2.5 py-1 font-mono text-[11px] text-muted">{r.tag}</span>
            </div>
            <p class="flex-1 text-sm text-body">{r.desc}</p>
            <span class="mt-4 inline-flex items-center gap-1.5 text-[13.5px] font-semibold text-accent">
              Abrir en GitHub
              <span class="transition-transform duration-300 group-hover:translate-x-1">↗</span>
            </span>
          </a>
        ))}
      </div>
    </div>
  </div>
</section>
