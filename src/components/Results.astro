---
import { getCollection } from 'astro:content';
import { site } from '../data/site';

const projects = (await getCollection('projects', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order
);

const covers: Record<number, string> = {
  1: 'from-[#0a2a4a] to-[#1c1c1e]',
  2: 'from-[#0f3b2e] to-[#1c1c1e]',
  3: 'from-[#3a2a0a] to-[#1c1c1e]',
  4: 'from-[#2a1a3a] to-[#1c1c1e]',
};
---

<section id="resultados" class="py-22">
  <div class="wrap">
    <p class="mb-3.5 text-[12.5px] font-semibold tracking-[0.14em] text-accent uppercase" data-reveal>
      Resultados
    </p>
    <h2 class="max-w-[680px] text-[clamp(28px,5vw,38px)] font-bold text-ink" data-reveal>
      Lo que he conseguido, con datos
    </h2>
    <p class="mt-3.5 mb-12 max-w-[620px] text-[17px] text-muted" data-reveal>
      Cifras reales y comprobables de cada proyecto. Sin porcentajes inflados:
      qué había, qué hice y qué cambió.
    </p>

    <div class="grid gap-8">
      {projects.map((p, idx) => (
        <article
          class="overflow-hidden rounded-card bg-surface shadow-card"
          data-reveal
        >
          <div class={`bg-gradient-to-br ${covers[p.data.cover]} p-7 text-white sm:p-9`}>
            <div class="flex flex-wrap items-center justify-between gap-3">
              <p class="font-mono text-[12.5px] text-[#5ac8fa]">
                {String(idx + 1).padStart(2, '0')} · {p.data.org}
              </p>
              <p class="font-mono text-[12.5px] text-white/60">{p.data.period}</p>
            </div>
            <h3 class="mt-3 max-w-[760px] font-display text-[clamp(22px,3.4vw,30px)] font-bold text-white">
              {p.data.title}
            </h3>
            {p.data.role && <p class="mt-1.5 text-[14px] font-medium text-white/70">{p.data.role}</p>}
            <p class="mt-4 max-w-[720px] text-[15.5px] text-white/85">{p.data.summary}</p>

            {p.data.metrics.length > 0 && (
              <dl class={`mt-7 grid gap-3 ${p.data.metrics.length >= 4 ? 'grid-cols-2 lg:grid-cols-4' : p.data.metrics.length === 1 ? 'grid-cols-1 sm:max-w-[340px]' : 'grid-cols-2'}`}>
                {p.data.metrics.map((m) => (
                  <div class="rounded-2xl bg-white/[0.07] p-4 ring-1 ring-white/10">
                    <dt class="sr-only">{m.label}</dt>
                    <dd class="font-display text-[clamp(22px,3vw,28px)] font-bold text-white">{m.value}</dd>
                    <dd class="mt-1 text-[12.5px] leading-snug text-white/65">{m.label}</dd>
                  </div>
                ))}
              </dl>
            )}
          </div>

          <div class="grid gap-6 p-7 sm:p-9 md:grid-cols-[1.6fr_1fr]">
            <div>
              <p class="mb-3 font-mono text-[12px] font-medium tracking-wide text-accent uppercase">Qué hice</p>
              <ul class="grid gap-2.5">
                {p.data.did.map((d) => (
                  <li class="flex gap-2.5 text-[15px] text-body">
                    <span class="mt-[9px] h-1.5 w-1.5 shrink-0 rounded-full bg-accent"></span>
                    <span>{d}</span>
                  </li>
                ))}
              </ul>
            </div>
            <div class="flex flex-col gap-4">
              <div>
                <p class="mb-3 font-mono text-[12px] font-medium tracking-wide text-accent uppercase">Tecnología</p>
                <div class="flex flex-wrap gap-1.5">
                  {p.data.tags.map((t) => (
                    <span class="rounded-md bg-surface-2 px-2.5 py-1 font-mono text-[12px] text-ink">{t}</span>
                  ))}
                </div>
              </div>
              {p.data.link && (
                <a
                  href={p.data.link} target="_blank" rel="noopener"
                  class="inline-flex w-fit items-center gap-1.5 text-[14px] font-semibold text-accent hover:underline"
                >
                  {p.data.linkLabel ?? 'Ver proyecto'} ↗
                </a>
              )}
            </div>
          </div>
        </article>
      ))}
    </div>

    <!-- Código público -->
    <a
      href={site.github} target="_blank" rel="noopener"
      class="group mt-8 flex flex-wrap items-center justify-between gap-4 rounded-card bg-surface-2 p-6 transition hover:-translate-y-0.5"
      data-reveal
    >
      <div class="flex items-center gap-4">
        <span class="grid h-11 w-11 place-items-center rounded-2xl bg-ink text-page">
          <svg viewBox="0 0 24 24" class="h-6 w-6" fill="currentColor" aria-hidden="true"><path d="M12 .5A11.5 11.5 0 0 0 .5 12a11.5 11.5 0 0 0 7.86 10.92c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.54-3.88-1.54-.53-1.34-1.3-1.7-1.3-1.7-1.06-.72.08-.71.08-.71 1.17.09 1.79 1.2 1.79 1.2 1.04 1.79 2.73 1.27 3.4.97.1-.76.41-1.27.74-1.56-2.55-.29-5.24-1.28-5.24-5.68 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.18 1.18a11 11 0 0 1 5.8 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.83 1.19 3.09 0 4.41-2.69 5.38-5.25 5.67.42.36.8 1.08.8 2.18v3.23c0 .31.21.67.8.56A11.5 11.5 0 0 0 23.5 12 11.5 11.5 0 0 0 12 .5Z"/></svg>
        </span>
        <div>
          <p class="font-display text-lg font-bold text-ink">Mi código, en abierto</p>
          <p class="text-[14px] text-muted">Laboratorios, pruebas y proyectos publicados en GitHub.</p>
        </div>
      </div>
      <span class="text-[14px] font-semibold text-accent">Ver GitHub <span class="inline-block transition-transform group-hover:translate-x-1">↗</span></span>
    </a>
  </div>
</section>
