---
const steps = [
  { tag: 'AHORA · 2026', title: 'Edge & telemetría', body: 'MQTT, Docker, Linux/Bash y fundamentos de IA aplicada.', now: true },
  { tag: 'SIGUIENTE', title: 'Edge-AI / TinyML', body: 'Modelos de ML corriendo en el propio microcontrolador.' },
  { tag: 'DESPUÉS', title: 'Seguridad & nube IoT', body: 'Secure boot, OTA firmado y plataformas IoT gestionadas.' },
  { tag: 'CERT', title: 'Claude Certified Architect', body: 'Certificación ancla en curso.' },
];
---

<section id="ahora" class="bg-[#1c1c1e] py-22 text-white">
  <div class="wrap">
    <p class="mb-3.5 text-[12.5px] font-semibold tracking-[0.14em] text-[#5ac8fa] uppercase">
      Trayectoria
    </p>
    <h2 class="text-[34px] font-bold text-white">En qué trabajo ahora</h2>
    <p class="mt-3.5 mb-10 max-w-[560px] text-[17px] text-[#8e8e93]">
      Subo por la pila IoT: del firmware a la inteligencia en el borde.
    </p>

    <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {steps.map((s) => (
        <div
          class:list={[
            'rounded-2xl p-[22px] shadow-[0_10px_30px_rgba(0,0,0,0.25)]',
            s.now
              ? 'bg-gradient-to-br from-[#0a2a4a] to-[#2c2c2e] shadow-[0_10px_34px_rgba(0,122,255,0.28)]'
              : 'bg-[#2c2c2e]',
          ]}
        >
          <p class="mb-2.5 font-mono text-xs text-[#5ac8fa]">{s.tag}</p>
          <h3 class="mb-1.5 font-display text-base text-white">{s.title}</h3>
          <p class="text-[13px] text-[#a1a1a6]">{s.body}</p>
        </div>
      ))}
    </div>
  </div>
</section>
