---
const services = [
  {
    icon: '⚙️',
    title: 'Firmware a medida',
    body: 'C/C++ sobre ARM Cortex-M, bare-metal o FreeRTOS. Arquitectura HAL / driver / aplicación, máquinas de estados y tiempo real determinista.',
    span: 'sm:col-span-2 sm:row-span-2',
    variant: 'dark',
    tag: 'C/C++',
  },
  {
    icon: '🧭',
    title: 'Sensores & drivers',
    body: 'Del datasheet al driver: IMU, SPI/I2C/UART, FIFO y bajo consumo.',
  },
  {
    icon: '📐',
    title: 'Fusión de sensores',
    body: 'Madgwick, Kalman, detección de eventos y métricas fiables.',
    variant: 'accent',
  },
  {
    icon: '📡',
    title: 'Conectividad IoT',
    body: 'BLE (GATT), MQTT y telemetría; bases de CAN-bus y RS-485/Modbus para entornos industriales.',
    span: 'sm:col-span-2',
  },
  {
    icon: '🔬',
    title: 'Validación HW',
    body: 'Puesta en marcha de PCB, osciloscopio y analizador lógico.',
  },
  {
    icon: '🖥️',
    title: 'Web & dashboards',
    body: 'Landing técnica y paneles de datos para tu producto conectado.',
  },
];

function tileClass(v?: string) {
  if (v === 'dark')
    return 'bg-gradient-to-br from-[#1c1c1e] to-[#2c2c2e] text-white';
  if (v === 'accent')
    return 'bg-gradient-to-br from-accent to-accent-2 text-white';
  return 'bg-surface';
}
---

<section id="servicios" class="py-22">
  <div class="wrap">
    <p class="mb-3.5 text-[12.5px] font-semibold tracking-[0.14em] text-accent uppercase">
      Qué hago
    </p>
    <h2 class="text-[34px] font-bold text-ink">Servicios de ingeniería</h2>
    <p class="mt-3.5 mb-10 max-w-[560px] text-[17px] text-muted">
      La capa donde el software toca el hardware. Elijo lo que mejor encaja con
      tu producto.
    </p>

    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {services.map((s) => (
        <div
          class:list={[
            'group relative overflow-hidden rounded-card p-6 shadow-card transition duration-300 hover:-translate-y-1 hover:shadow-card-lg',
            tileClass(s.variant),
            s.span,
          ]}
        >
          <div
            class:list={[
              'mb-4 grid h-[42px] w-[42px] place-items-center rounded-xl text-xl',
              s.variant ? 'bg-white/15' : 'bg-surface-2',
            ]}
          >
            {s.icon}
          </div>
          <h3
            class:list={['mb-2 text-lg font-bold', s.variant ? 'text-white' : 'text-ink']}
          >
            {s.title}
          </h3>
          <p
            class:list={[
              'text-sm leading-relaxed',
              s.variant ? 'text-white/85' : 'text-muted',
            ]}
          >
            {s.body}
          </p>
          {s.tag && (
            <p class="mt-6 font-display text-[40px] font-bold leading-none text-white">
              {s.tag}
            </p>
          )}
        </div>
      ))}
    </div>
  </div>
</section>
