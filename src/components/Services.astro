---
// Servicios freelance: tarjetas que enlazan a la página de cada servicio.
import { services, formatPrice } from '../data/services';

interface Props {
  /** Nivel del título de la sección (h1 en /servicios, h2 en la home). */
  as?: 'h1' | 'h2';
}
const { as: Heading = 'h2' } = Astro.props;
---

<section id="servicios" class="py-22">
  <div class="wrap">
    <p class="mb-3.5 text-[12.5px] font-semibold tracking-[0.14em] text-accent uppercase" data-reveal>
      Servicios
    </p>
    <Heading class="max-w-[680px] text-[clamp(28px,5vw,38px)] font-bold text-ink" data-reveal>
      Qué puedo hacer por tu proyecto
    </Heading>
    <p class="mt-3.5 mb-10 max-w-[620px] text-[17px] text-muted" data-reveal>
      Tres servicios, cada uno con tres niveles de precio cerrado y un proceso
      claro. Trabajo desde Barcelona con clientes de toda España.
    </p>

    <div class="grid gap-5 md:grid-cols-3">
      {services.map((s, i) => (
        <a
          href={`/servicios/${s.slug}`}
          class="group flex flex-col rounded-card bg-surface p-7 shadow-card transition duration-300 hover:-translate-y-1 hover:shadow-card-lg"
          data-reveal
          style={`--reveal-delay:${i * 100}ms`}
        >
          <span class="mb-5 grid h-12 w-12 place-items-center rounded-xl bg-surface-2 text-2xl" aria-hidden="true">{s.icon}</span>
          <h3 class="text-xl font-bold text-ink group-hover:text-accent">{s.name}</h3>
          <p class="mt-2 flex-1 text-[15px] leading-relaxed text-body">{s.card}</p>
          <ul class="mt-5 grid gap-1.5 border-t border-sep pt-4 text-[13.5px]">
            {s.tiers.map((t) => (
              <li class="flex items-baseline justify-between gap-3">
                <span class="text-muted">{t.name}</span>
                <span class="font-semibold text-ink">desde {formatPrice(t.price)}</span>
              </li>
            ))}
          </ul>
          <span class="mt-5 text-[14.5px] font-semibold text-accent">
            Ver niveles y proceso <span class="inline-block transition-transform group-hover:translate-x-1">→</span>
          </span>
        </a>
      ))}
    </div>
    <p class="mt-5 text-[13px] text-muted">Precios orientativos, IVA no incluido.</p>
  </div>
</section>
