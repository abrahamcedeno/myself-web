---
const columns = [
  { title: 'Dispositivo', tags: ['C', 'C++', 'FreeRTOS', 'ARM Cortex-M', 'Bare-metal'] },
  { title: 'Conectividad', tags: ['BLE / GATT', 'SPI', 'I2C', 'UART', 'MQTT', 'CAN'] },
  { title: 'Edge & datos', tags: ['Python', 'Docker', 'Linux', 'Kalman', 'Edge-AI'] },
  { title: 'Hardware & método', tags: ['KiCad', 'Osciloscopio', 'Git', 'PlatformIO'] },
];
---

<section id="stack" class="bg-surface-2 py-22">
  <div class="wrap">
    <p class="mb-3.5 text-[12.5px] font-semibold tracking-[0.14em] text-accent uppercase">
      Herramientas
    </p>
    <h2 class="text-[34px] font-bold text-ink">Stack técnico</h2>
    <p class="mt-3.5 mb-10 max-w-[560px] text-[17px] text-muted">
      Organizado por capa, del dispositivo al dato.
    </p>

    <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {columns.map((col) => (
        <div>
          <h3 class="mb-3.5 font-sans text-[13px] font-semibold tracking-[0.1em] text-muted uppercase">
            {col.title}
          </h3>
          <div class="flex flex-wrap gap-2">
            {col.tags.map((tag) => (
              <span class="rounded-lg bg-surface px-3 py-[7px] font-mono text-[13px] font-medium text-ink shadow-sm">
                {tag}
              </span>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
