---
// Página de cada artículo: /blog/<slug>. El contenido está en src/content/blog.
import { render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import { site } from '../../data/site';
import { serviceBySlug, formatPrice } from '../../data/services';
import { getPosts, formatDate, readingTime, type Post } from '../../data/blog';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post, posts } }));
}

const { post, posts } = Astro.props as { post: Post; posts: Post[] };
const { Content, headings } = await render(post);
const d = post.data;
const svc = d.service ? serviceBySlug(d.service) : undefined;
const others = posts.filter((p) => p.id !== post.id).slice(0, 2);
const toc = headings.filter((h) => h.depth === 2);

const pageUrl = new URL(`/blog/${post.id}`, Astro.site).href;
const home = new URL('/', Astro.site).href;
const image = svc ? svc.ogImage : '/og-image.png';

const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: d.title,
  description: d.description,
  url: pageUrl,
  mainEntityOfPage: pageUrl,
  image: new URL(image, Astro.site).href,
  datePublished: d.date.toISOString(),
  dateModified: (d.updated ?? d.date).toISOString(),
  inLanguage: 'es-ES',
  keywords: d.tags.join(', '),
  author: { '@type': 'Person', name: site.legalName, alternateName: site.name, url: home },
  publisher: { '@type': 'Person', name: site.legalName, url: home },
  ...(svc && { about: { '@type': 'Service', name: svc.serviceType, url: new URL(`/servicios/${svc.slug}`, Astro.site).href } }),
};
const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: home },
    { '@type': 'ListItem', position: 2, name: 'Blog', item: new URL('/blog', Astro.site).href },
    { '@type': 'ListItem', position: 3, name: d.title, item: pageUrl },
  ],
};
---

<Layout
  title={`${d.title} | ${site.name}`}
  description={d.description}
  image={image}
  keywords={d.tags}
  schema={[articleLd, breadcrumbLd]}
>
  <Nav />
  <main id="contenido" class="py-12 sm:py-16">
    <article class="wrap max-w-[760px]">
      <nav aria-label="Ruta" class="mb-8 text-[13px] text-muted">
        <ol class="flex flex-wrap items-center gap-1.5">
          <li><a href="/" class="hover:text-accent">Inicio</a></li>
          <li aria-hidden="true">›</li>
          <li><a href="/blog" class="hover:text-accent">Blog</a></li>
        </ol>
      </nav>

      <header>
        {svc && (
          <p class="mb-3.5 text-[12.5px] font-semibold tracking-[0.14em] text-accent uppercase">
            {svc.icon}&nbsp; {svc.name}
          </p>
        )}
        <h1 class="text-[clamp(32px,6vw,48px)] font-bold text-ink">{d.title}</h1>
        <p class="mt-4 text-lg text-muted">{d.description}</p>
        <p class="mt-5 text-[14px] text-muted">
          Por <a href="/#sobre" class="font-semibold text-ink hover:text-accent">{site.name}</a>
          {' · '}<time datetime={d.date.toISOString()}>{formatDate(d.date)}</time>
          {d.updated && <> · actualizado el <time datetime={d.updated.toISOString()}>{formatDate(d.updated)}</time></>}
          {' · '}{readingTime(post.body)} min de lectura
        </p>
      </header>

      {toc.length > 2 && (
        <nav aria-label="Índice" class="mt-10 rounded-card bg-surface-2 p-6">
          <p class="mb-3 font-mono text-[12px] font-medium tracking-wide text-accent uppercase">En este artículo</p>
          <ol class="grid gap-1.5 text-[15px]">
            {toc.map((h) => (
              <li><a href={`#${h.slug}`} class="text-body hover:text-accent">{h.text}</a></li>
            ))}
          </ol>
        </nav>
      )}

      <div class="prose-blog mt-10">
        <Content />
      </div>

      {svc && (
        <aside class="mt-14 rounded-card bg-gradient-to-br from-accent to-accent-2 p-8 text-white">
          <p class="font-mono text-[12px] font-medium tracking-wide text-white/80 uppercase">{svc.icon} Servicio</p>
          <h2 class="mt-2 text-2xl font-bold text-white">{svc.h1}</h2>
          <p class="mt-2 text-[16px] text-white/85">
            Tres niveles de precio cerrado, desde {formatPrice(svc.tiers[0].price)}, y un proceso paso a paso.
          </p>
          <div class="mt-6 flex flex-wrap gap-3">
            <a href={`/servicios/${svc.slug}`} class="rounded-full bg-white px-6 py-3 text-[15px] font-semibold text-[#1c1c1e] transition hover:-translate-y-0.5">
              Ver precios y proceso
            </a>
            <a href={`/servicios/${svc.slug}#contacto`} class="rounded-full bg-white/15 px-6 py-3 text-[15px] font-semibold text-white transition hover:-translate-y-0.5">
              Pedir presupuesto
            </a>
          </div>
        </aside>
      )}

      {others.length > 0 && (
        <section class="mt-16">
          <h2 class="mb-5 text-2xl font-bold text-ink">Sigue leyendo</h2>
          <div class="grid gap-4 sm:grid-cols-2">
            {others.map((o) => (
              <a href={`/blog/${o.id}`} class="group rounded-card bg-surface p-6 shadow-card transition hover:-translate-y-0.5 hover:shadow-card-lg">
                <span class="block font-display text-lg font-bold text-ink group-hover:text-accent">{o.data.title}</span>
                <span class="mt-2 block text-[14.5px] text-muted">{o.data.description}</span>
              </a>
            ))}
          </div>
        </section>
      )}
    </article>
  </main>
  <Footer />
</Layout>
