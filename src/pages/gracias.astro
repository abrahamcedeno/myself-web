---
// Página de vuelta tras enviar el formulario sin JavaScript. No se indexa.
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Mensaje enviado — Abraham Cedeño" description="Gracias por tu mensaje." noindex>
  <Nav />
  <main id="contenido" class="py-28">
    <div class="wrap max-w-[620px] text-center">
      <p class="text-5xl" aria-hidden="true">✅</p>
      <h1 class="mt-6 text-[clamp(30px,6vw,42px)] font-bold text-ink">¡Mensaje enviado!</h1>
      <p class="mt-4 text-lg text-muted">Gracias por escribirme. Te respondo lo antes posible.</p>
      <a href="/" class="mt-8 inline-block rounded-full bg-accent px-7 py-3.5 text-[15px] font-semibold text-white">Volver al inicio</a>
    </div>
  </main>
  <Footer />
</Layout>
