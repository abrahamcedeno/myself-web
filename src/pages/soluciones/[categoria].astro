---
// La sección "Soluciones" (web freelance) se retiró. Las URLs antiguas
// redirigen a Resultados para no dejar enlaces rotos.
import { categories } from '../../data/categories';

export function getStaticPaths() {
  return categories.map((c) => ({ params: { categoria: c.slug } }));
}

return Astro.redirect('/#resultados');
---
