---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Contact from '../../components/Contact.astro';
import Footer from '../../components/Footer.astro';
import { categories, categoryBySlug } from '../../data/categories';

// Genera una página estática por cada categoría.
export function getStaticPaths() {
  return categories.map((c) => ({ params: { categoria: c.slug } }));
}

const { categoria } = Astro.params;
const cat = categoryBySlug(categoria!)!;

const projects = (await getCollection('projects'))
  .filter((p) => !p.data.draft && (p.data.categories ?? []).includes(categoria!))
  .sort((a, b) => a.data.order - b.data.order);

const covers: Record<number, string> = {
  1: 'from-[#e8f0ff] to-[#f5f5f7] dark:from-[#0a2a4a] dark:to-[#1c1c1e]',
  2: 'from-[#eafff2] to-[#f5f5f7] dark:from-[#10331f] dark:to-[#1c1c1e]',
  3: 'from-[#fff4e5] to-[#f5f5f7] dark:from-[#3a2a10] dark:to-[#1c1c1e]',
  4: 'from-[#f3e8ff] to-[#f5f5f7] dark:from-[#2a1a3a] dark:to-[#1c1c1e]',
};
---

<Layout
  title={`Soluciones · ${cat.label} — Abraham Cedeño`}
  description={cat.tagline}
>
  <Nav />
  <main id="contenido">
    <section class="py-16 sm:py-20">
      <div class="wrap">
        <a
          href="/#soluciones"
          class="mb-8 inline-flex items-center gap-1.5 text-sm font-medium text-muted transition-colors hover:text-accent"
        >
          <span aria-hidden="true">←</span> Todas las soluciones
        </a>

        <p class="mb-3.5 text-[12.5px] font-semibold tracking-[0.14em] text-accent uppercase" data-reveal>
          Soluciones · {cat.short}
        </p>
        <h1 class="flex items-center gap-3 text-[clamp(30px,6vw,46px)] font-bold text-ink" data-reveal>
          <span aria-hidden="true">{cat.icon}</span> {cat.label}
        </h1>
        <p class="mt-4 max-w-[620px] text-[18px] text-body" data-reveal>{cat.tagline}</p>

        <!-- Navegación entre categorías -->
        <div class="mt-8 flex flex-wrap gap-2" data-reveal>
          {categories.map((c) => (
            <a
              href={`/soluciones/${c.slug}`}
              aria-current={c.slug === cat.slug ? 'page' : undefined}
              class:list={[
                'rounded-full px-3.5 py-1.5 text-[13px] font-medium transition',
                c.slug === cat.slug
                  ? 'bg-ink text-white dark:bg-white dark:text-black'
                  : 'bg-surface-2 text-body hover:text-accent',
              ]}
            >
              {c.short}
            </a>
          ))}
        </div>

        <!-- Proyectos relacionados -->
        <div class="mt-12">
          {projects.length > 0 ? (
            <div class="grid grid-cols-1 gap-5.5 md:grid-cols-2">
              {projects.map((p) => (
                <article
                  class="flex flex-col overflow-hidden rounded-card bg-surface shadow-card transition duration-300 hover:-translate-y-1 hover:shadow-card-lg"
                  data-reveal
                >
                  <div
                    class:list={[
                      'grid h-[140px] place-items-center bg-gradient-to-br px-5 text-center font-display text-lg font-bold text-ink',
                      covers[p.data.cover],
                    ]}
                  >
                    {p.data.title}
                  </div>
                  <div class="flex flex-1 flex-col p-6">
                    <h2 class="mb-2 text-[19px] font-bold text-ink">{p.data.title}</h2>
                    <p class="mb-4 flex-1 text-sm text-body">{p.data.summary}</p>
                    <div class="mb-4 flex flex-wrap gap-1.5">
                      {p.data.tags.map((tag) => (
                        <span class="rounded-md bg-surface-2 px-2.5 py-1 font-mono text-[11.5px] text-muted">
                          {tag}
                        </span>
                      ))}
                    </div>
                    {(p.data.repo || p.data.demo) && (
                      <div class="flex gap-4 text-[13.5px] font-semibold text-accent">
                        {p.data.repo && (
                          <a href={p.data.repo} target="_blank" rel="noopener">GitHub ↗</a>
                        )}
                        {p.data.demo && (
                          <a href={p.data.demo} target="_blank" rel="noopener">Ver ↗</a>
                        )}
                      </div>
                    )}
                  </div>
                </article>
              ))}
            </div>
          ) : (
            <div class="rounded-card bg-surface-2 p-8 text-center">
              <p class="text-[17px] text-body">
                Aún no hay casos publicados en esta categoría, pero es una de mis
                líneas de trabajo.
                <a href="/#contacto" class="font-semibold text-accent"> Cuéntame tu idea</a> y
                la construimos.
              </p>
            </div>
          )}
        </div>
      </div>
    </section>

    <Contact />
  </main>
  <Footer />
</Layout>
